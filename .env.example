# Copy this file to `.env` and fill in your own values.
# The app bundles `.env` as an asset, so the file must exist before you build.
# Never commit the real `.env` (it is git-ignored).

# EcoPin backend API base URL (e.g. http://10.0.2.2:3000 from the Android emulator)
BACKEND_URL=

# Public web URL used in shared report links and the photo verification stamp
WEB_BASE_URL=

# Supabase project: public values only. Never put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# CARTO basemap tiles for the maps
CARTO_API_KEY=

# Test-only switch that skips live GPS capture during photo verification. Keep false.
SYNTHETIC_TEST=false
